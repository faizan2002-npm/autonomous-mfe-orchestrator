datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum DriftType {
  FIELD_RENAMED
  FIELD_DELETED
  FIELD_ADDED
  TYPE_CHANGED
  STRUCTURE_MUTATION
  MULTI_FIELD_MUTATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PatchStatus {
  GENERATING
  VALIDATED
  CANARY
  ACTIVE
  FAILED
  SUPERSEDED
  ROLLED_BACK
}

enum GovernanceStatus {
  AUTO_APPROVED
  PENDING_REVIEW
  APPROVED
  REJECTED
  ESCALATED
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  DRIFTING
  FAILING
}

model ServiceRegistry {
  id              String         @id @default(uuid())
  serviceName     String         @unique @map("service_name")
  serviceType     String         @map("service_type")
  endpointUrl     String         @map("endpoint_url")
  mfeConsumer     String         @map("mfe_consumer")
  status          ServiceStatus  @default(HEALTHY)
  lastCheckedAt   DateTime?      @map("last_checked_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  contracts       ApiContract[]
  driftEvents     DriftEvent[]

  @@map("service_registries")
}

model ApiContract {
  id              String         @id @default(uuid())
  serviceId       String         @map("service_id")
  endpointPath    String         @map("endpoint_path")
  httpMethod      String         @map("http_method")
  schemaSnapshot  Json           @map("schema_snapshot")
  fieldCount      Int            @map("field_count")
  version         Int            @default(1)
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")

  service         ServiceRegistry @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  driftEvents     DriftEvent[]
  patches         PatchRegistry[]

  @@unique([serviceId, endpointPath, httpMethod, version])
  @@map("api_contracts")
}

model DriftEvent {
  id                String            @id @default(uuid())
  contractId        String            @map("contract_id")
  serviceId         String            @map("service_id")
  driftType         DriftType         @map("drift_type")
  severity          Severity          @default(LOW)
  driftCoefficient  Float             @map("drift_coefficient")
  observedPayload   Json              @map("observed_payload")
  diffDetails       Json              @map("diff_details")
  isBreaking        Boolean           @map("is_breaking")
  detectedAt        DateTime          @default(now()) @map("detected_at")

  contract          ApiContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service           ServiceRegistry   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  patches           PatchRegistry[]
  governanceLogs    GovernanceAudit[]

  @@map("drift_events")
}

model PatchRegistry {
  id                String            @id @default(uuid())
  contractId        String            @map("contract_id")
  driftEventId      String            @map("drift_event_id")
  adapterCode       String            @map("adapter_code")
  adapterSignature  String            @map("adapter_signature")
  confidenceScore   Float             @map("confidence_score")
  status            PatchStatus       @default(GENERATING)
  canaryPercent     Int               @default(0) @map("canary_percent")
  deployedAt        DateTime?         @map("deployed_at")
  rolledBackAt      DateTime?         @map("rolled_back_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  contract          ApiContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  driftEvent        DriftEvent        @relation(fields: [driftEventId], references: [id], onDelete: Cascade)
  canaryMetrics     CanaryMetric[]
  governanceLogs    GovernanceAudit[]

  @@map("patch_registries")
}

model CanaryMetric {
  id                String        @id @default(uuid())
  patchId           String        @map("patch_id")
  windowStart       DateTime      @map("window_start")
  windowEnd         DateTime      @map("window_end")
  baselineRequests  Int           @map("baseline_requests")
  baselineErrors    Int           @map("baseline_errors")
  canaryRequests    Int           @map("canary_requests")
  canaryErrors      Int           @map("canary_errors")
  avgLatencyMs      Float         @map("avg_latency_ms")
  promoted          Boolean       @default(false)
  evaluationNotes   String?       @map("evaluation_notes")

  patch             PatchRegistry @relation(fields: [patchId], references: [id], onDelete: Cascade)

  @@map("canary_metrics")
}

model GovernanceAudit {
  id              String            @id @default(uuid())
  driftEventId    String            @map("drift_event_id")
  patchId         String?           @map("patch_id")
  status          GovernanceStatus  @default(PENDING_REVIEW)
  reviewer        String?
  reviewNotes     String?           @map("review_notes")
  reasoningTrace  String            @map("reasoning_trace")
  reviewedAt      DateTime?         @map("reviewed_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  driftEvent      DriftEvent        @relation(fields: [driftEventId], references: [id], onDelete: Cascade)
  patch           PatchRegistry?    @relation(fields: [patchId], references: [id], onDelete: SetNull)

  @@map("governance_audits")
}
