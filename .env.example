# Database: Supabase Postgres (dashboard -> project -> Connect).
# The app uses the transaction pooler (port 6543) and migrations the session pooler (5432);
# both URLs are built from these keys. Set DATABASE_URL / DIRECT_URL instead to override.
SUPABASE_PROJECT_REF="[PROJECT-REF]"
SUPABASE_DB_PASSWORD="[YOUR-PASSWORD]"
SUPABASE_POOLER_HOST="aws-0-ap-south-1.pooler.supabase.com"

# Redis: Upstash (free tier). Console -> database -> Connect -> TCP. Use rediss:// (TLS).
REDIS_URL="rediss://default:[YOUR-UPSTASH-TOKEN]@[YOUR-ENDPOINT].upstash.io:6379"

# Adapter generation: Google Gemini (https://aistudio.google.com/apikey).
# Leave GEMINI_API_KEY empty to use only the deterministic field-rename fallback.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Application Ports (frontend ports are fixed in each app's vite.config.ts: dashboard 5100, shell 5000, remotes 5001/5002)
GATEWAY_PORT=4000
USER_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002

# Upstream services proxied by the gateway
USER_SERVICE_URL="http://localhost:3001"
ORDER_SERVICE_URL="http://localhost:3002"

# Drift Detection Configuration
# Drift coefficient (1 - Jaccard similarity, 0..1) above which a response counts as drifted.
DRIFT_SIMILARITY_THRESHOLD=0.15
# Share of traffic (0..100) a new patch receives until it is promoted.
CANARY_TRAFFIC_PERCENTAGE=10

# Dashboard sign-in (Supabase Auth). SUPABASE_URL defaults to https://<SUPABASE_PROJECT_REF>.supabase.co.
# SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Browser origins allowed to call the gateway (comma-separated).
ALLOWED_ORIGINS="http://localhost:5100,http://localhost:5000,http://localhost:5001,http://localhost:5002"

# Frontend apps (Vite reads VITE_* from this file; these values ship to the browser).
VITE_GATEWAY_URL="http://localhost:4000"
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Supabase -> Project Settings -> API Keys -> Publishable key (safe to expose).
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_DASHBOARD_URL="http://localhost:5100"
VITE_SHELL_URL="http://localhost:5000"
VITE_MFE_USER_ENTRY="http://localhost:5001/remoteEntry.js"
VITE_MFE_ORDER_ENTRY="http://localhost:5002/remoteEntry.js"

# Security (required). Generate each with: openssl rand -base64 32
# ENCRYPTION_KEY encrypts stored secrets (service credentials, BYO Gemini keys);
# KEY_PEPPER hashes consumer API keys and invitation tokens. Never change them once data exists.
ENCRYPTION_KEY=""
KEY_PEPPER=""
# Lets org services point at private/localhost addresses. Only for local development and demos.
ALLOW_PRIVATE_UPSTREAMS="false"
# Dashboard URL used in invitation links.
APP_URL="http://localhost:5100"
# Proxied requests allowed per consumer API key per minute.
RATE_LIMIT_PER_MINUTE=600

# Notifications: email (invitations, drift and review alerts).
# EMAIL_PROVIDER: log (print to the gateway log, default) | resend | smtp
EMAIL_PROVIDER="log"
EMAIL_FROM="MFE Orchestrator <onboarding@resend.dev>"
# Resend (https://resend.com/api-keys); onboarding@resend.dev only reaches your own address until you verify a domain.
RESEND_API_KEY=""
# Any SMTP server, e.g. smtps://user:password@smtp.gmail.com:465 (use an app password).
SMTP_URL=""

# Notifications: browser web push. Generate a pair once with: npx web-push generate-vapid-keys
# Leave both empty to disable push. VAPID_SUBJECT is a mailto: or https: contact for push services.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Consumer keys for the demo apps, written by `pnpm db:seed --write-env`.
VITE_MFE_CONSUMER_KEY=""
REPORT_SERVICE_KEY=""

# Monitoring: bearer token a scraper (e.g. Grafana Cloud) sends to read GET /metrics.
# Leave empty to allow only signed-in dashboard users. Generate with: openssl rand -base64 32
METRICS_TOKEN=""
