{
  "name": "autonomous-mfe-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous Micro-Frontend Orchestrator with Agentic AI Drift Healing",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "pnpm --filter @orchestrator/database db:migrate",
    "db:generate": "pnpm --filter @orchestrator/database db:generate",
    "test:integration": "bash scripts/test-integration.sh",
    "test:nest": "TEST_SUITE=nest bash scripts/test-integration.sh",
    "test:e2e": "bash scripts/test-e2e.sh",
    "db:seed": "pnpm --filter @orchestrator/gateway seed --",
    "test:jest": "jest --config jest.config.global.js",
    "test:jest:watch": "jest --config jest.config.global.js --watch",
    "test:jest:coverage": "jest --config jest.config.global.js --coverage",
    "test:e2e:headed": "HEADED=true bash scripts/test-e2e.sh",
    "test:all": "pnpm build && pnpm lint && pnpm test && pnpm test:integration && pnpm test:e2e",
    "prepare": "husky install",
    "test:e2e:services": "pnpm exec playwright test apps/e2e/tests/services.spec.ts",
    "test:e2e:consumers": "pnpm exec playwright test apps/e2e/tests/consumers.spec.ts",
    "test:e2e:notifications": "pnpm exec playwright test apps/e2e/tests/notifications.spec.ts",
    "test:integration:services": "TEST_DATABASE_URL=... TEST_REDIS_URL=... node --test apps/integration-tests/services.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "@swc/core": "^1.3.99",
    "@swc/jest": "^0.2.29",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}